# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this to .env for local development
#
# LOCAL:      cp .env.example .env  →  fill in real values  →  docker compose up
# PRODUCTION: set these in Railway dashboard → Project → Variables
#             Never commit .env to git. Railway injects PORT automatically.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (Anthropic Claude API — used directly, no AWS/Bedrock needed) ─────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── News & Sentiment ──────────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── HuggingFace (optional — speeds up model downloads behind a proxy) ─────────
# HF_HOME=/tmp/hf_cache
# TRANSFORMERS_CACHE=/tmp/hf_cache

# ── Local dev overrides ───────────────────────────────────────────────────────
# PORT is injected automatically by Railway in production.
# Uncomment below only if you need to override locally:
# PORT=8080
